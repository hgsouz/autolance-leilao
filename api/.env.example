# --- Servidor ---
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# --- Banco (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leilao
# Use true em provedores que exigem SSL na conexão (Neon, Supabase, Render externo)
DATABASE_SSL=false

# --- Segredos (OBRIGATÓRIO trocar em produção; mínimo de 16 caracteres) ---
JWT_SECRET=troque-este-segredo-jwt-em-producao
# Chave do HMAC que sela o histórico de lances. NÃO fica no banco, por isso quem
# altera o banco diretamente não consegue recalcular os hashes.
CHAIN_SECRET=troque-este-segredo-da-cadeia-em-producao

# --- CORS: origem(ns) do front separadas por vírgula, ou * ---
CORS_ORIGIN=http://localhost:5173

# --- Inicialização ---
AUTO_MIGRATE=true
# Popula leiloeiro, 2 clientes e lotes de exemplo se o banco estiver vazio
AUTO_SEED=true

# --- Regras do leilão ---
SNIPING_WINDOW_SECONDS=120
SNIPING_EXTENSION_SECONDS=120

# --- API externa de veículos (Tabela FIPE) ---
FIPE_BASE_URL=https://fipe.parallelum.com.br/api/v2
# Token opcional (aumenta o limite de requisições). Gere em https://fipe.online
FIPE_TOKEN=
CATALOG_TTL_HOURS=24
